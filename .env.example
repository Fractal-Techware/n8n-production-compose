# FTW n8n Production Compose (free edition) — single instance
# Create this file with ./scripts/init-secrets.sh: it generates the secrets below and never
# overwrites an existing .env.

# --- public address ----------------------------------------------------------
# DNS name that points at this server
N8N_DOMAIN=n8n.example.com
# Full public URL, no trailing slash (include :port only if not 443)
N8N_PUBLIC_URL=https://n8n.example.com
# Your email for Let's Encrypt / ZeroSSL, or "internal" for Caddy's local CA (testing only)
CADDY_TLS=admin@example.com
# Interface and ports Caddy publishes on the host
BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443

# --- secrets (generated by scripts/init-secrets.sh) ---------------------------
# BACK UP N8N_ENCRYPTION_KEY SEPARATELY: without it, stored credentials cannot be decrypted.
N8N_ENCRYPTION_KEY=
POSTGRES_PASSWORD=
N8N_RUNNERS_AUTH_TOKEN=

# --- database ------------------------------------------------------------------
POSTGRES_DB=n8n
POSTGRES_USER=n8n
DB_POSTGRESDB_POOL_SIZE=4

# --- behaviour -----------------------------------------------------------------
GENERIC_TIMEZONE=UTC
EXECUTIONS_TIMEOUT=3600
EXECUTIONS_TIMEOUT_MAX=7200
EXECUTIONS_DATA_MAX_AGE=336
EXECUTIONS_DATA_PRUNE_MAX_COUNT=50000
N8N_CONCURRENCY_PRODUCTION_LIMIT=20
N8N_LOG_LEVEL=info
N8N_LOG_FORMAT=text
